<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — Admin" : "Admin — Kickoff")</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: { brand: { DEFAULT: '#16a34a', dark: '#15803d' } } } }
        }
    </script>
</head>
<body class="bg-gray-100 text-gray-900">

<div class="flex min-h-screen">
    <aside class="w-60 bg-gray-900 text-white flex flex-col shrink-0">
        <div class="px-6 py-5 border-b border-gray-700">
            <a href="/" class="text-lg font-black text-green-400 tracking-tight">Kickoff</a>
            <p class="text-xs text-gray-500 mt-0.5">Admin Panel</p>
        </div>

        <nav class="flex-1 p-3 space-y-1 text-sm">
            @{
                var menu = ViewBag.AdminMenu as string ?? "";
                string NavClass(string key) => key == menu
                    ? "flex items-center gap-3 px-3 py-2.5 rounded-lg bg-green-700 text-white font-medium"
                    : "flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition-colors";
            }
            <a asp-controller="Admin" asp-action="Index" class="@NavClass("dashboard")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"/></svg>
                Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Products" class="@NavClass("products")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                Proizvodi
            </a>
            <a asp-controller="Admin" asp-action="Orders" class="@NavClass("orders")">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                Narudžbe
            </a>
            <div class="pt-3 border-t border-gray-700 mt-3">
                <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    Na web shop
                </a>
            </div>
        </nav>

        <div class="px-4 py-4 border-t border-gray-700">
            <p class="text-xs text-gray-400 truncate">@User.Identity?.Name</p>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-1">
                <button type="submit" class="text-xs text-red-400 hover:text-red-300 transition-colors">Odjava</button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
            <h1 class="text-xl font-bold text-gray-800">@ViewData["Title"]</h1>
            @if (TempData["Success"] is string msg)
            {
                <span class="bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-2 rounded-lg">@msg</span>
            }
            @if (TempData["Error"] is string err)
            {
                <span class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-2 rounded-lg">@err</span>
            }
        </header>

        <main class="flex-1 p-8 overflow-auto">
            @RenderBody()
        </main>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
