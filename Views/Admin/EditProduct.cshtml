@model KickoffShop.Models.ProductEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Novi proizvod" : "Uredi proizvod";
    ViewBag.AdminMenu = "products";
    Layout = "_AdminLayout";
}

<div class="max-w-3xl">
    <div class="mb-6">
        <a asp-action="Products" class="text-sm text-gray-500 hover:text-gray-700">← Natrag na proizvode</a>
    </div>

    <form asp-action="EditProduct" method="post" enctype="multipart/form-data" class="space-y-8">
        <input type="hidden" asp-for="Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <!-- Basic info -->
        <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
            <h2 class="font-bold text-gray-800">Osnovni podaci</h2>

            <div class="grid sm:grid-cols-2 gap-5">
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Naziv</label>
                    <input asp-for="Title" type="text" placeholder="Nike Strike Football"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-transparent" />
                    <span asp-validation-for="Title" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Kategorija</label>
                    <input asp-for="ProductType" type="text" placeholder="Lopte, Kopačke, Dresovi..."
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-transparent" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Handle (URL slug)</label>
                    <input asp-for="Handle" type="text" placeholder="auto-generira se iz naziva"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-transparent" />
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Slika proizvoda</label>
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="flex gap-5 items-start">
                        <div id="img-preview-wrap" class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "hidden" : "") shrink-0">
                            <img id="img-preview" src="@Model.ImageUrl" alt="Trenutna slika"
                                 class="w-28 h-28 object-cover rounded-xl border border-gray-200 bg-gray-50" />
                        </div>

                        <label for="ImageFile"
                               class="flex-1 flex flex-col items-center justify-center gap-2 border-2 border-dashed border-gray-300 hover:border-green-500 rounded-xl px-6 py-8 cursor-pointer transition-colors group">
                            <svg class="w-8 h-8 text-gray-300 group-hover:text-green-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <span id="upload-label" class="text-sm text-gray-500 group-hover:text-green-600 transition-colors">
                                @(string.IsNullOrEmpty(Model.ImageUrl) ? "Kliknite za odabir slike" : "Kliknite za zamjenu slike")
                            </span>
                            <span class="text-xs text-gray-400">JPG, PNG, WebP, GIF — max 5 MB</span>
                            <input id="ImageFile" name="ImageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" onchange="previewImage(this)" />
                        </label>
                    </div>
                    <span asp-validation-for="ImageFile" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Opis</label>
                    <textarea asp-for="Description" rows="3" placeholder="Opis proizvoda..."
                              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-transparent resize-none"></textarea>
                </div>
            </div>
        </div>

        <!-- Variants -->
        <div class="bg-white rounded-xl border border-gray-200 p-6">
            <div class="flex justify-between items-center mb-5">
                <h2 class="font-bold text-gray-800">Varijante</h2>
                <button type="button" onclick="addVariant()"
                        class="text-sm text-green-700 hover:text-green-800 font-semibold border border-green-200 hover:bg-green-50 px-3 py-1.5 rounded-lg transition-colors">
                    + Dodaj varijantu
                </button>
            </div>

            <div class="grid grid-cols-12 gap-3 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 px-1">
                <div class="col-span-3">Naziv</div>
                <div class="col-span-3">Cijena (€)</div>
                <div class="col-span-3">Cijena prije (€)</div>
                <div class="col-span-2">Zaliha</div>
                <div class="col-span-1"></div>
            </div>

            <div id="variants-container" class="space-y-2">
                @for (int i = 0; i < Model.Variants.Count; i++)
                {
                    <div class="variant-row grid grid-cols-12 gap-3 items-center bg-gray-50 rounded-lg px-3 py-2.5 @(Model.Variants[i].Delete ? "opacity-40" : "")" id="vrow-@i">
                        <input type="hidden" name="Variants[@i].Id" value="@Model.Variants[i].Id" />
                        <input type="hidden" name="Variants[@i].Delete" value="false" class="delete-input" />

                        <div class="col-span-3">
                            <input name="Variants[@i].Title" value="@Model.Variants[i].Title" type="text" required placeholder="S, M, L / Vel. 5..."
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
                        </div>
                        <div class="col-span-3">
                            <input name="Variants[@i].Price" value="@Model.Variants[i].Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0.01" required
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
                        </div>
                        <div class="col-span-3">
                            <input name="Variants[@i].CompareAtPrice" value="@(Model.Variants[i].CompareAtPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" type="number" step="0.01" min="0"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
                        </div>
                        <div class="col-span-2">
                            <input name="Variants[@i].Stock" value="@Model.Variants[i].Stock" type="number" min="0" required
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
                        </div>
                        <div class="col-span-1 text-right">
                            @if (Model.Variants[i].Id > 0)
                            {
                                <button type="button" onclick="markDelete(@i, this)"
                                        class="text-red-400 hover:text-red-600 text-lg leading-none transition-colors" title="Označi za brisanje">×</button>
                            }
                            else
                            {
                                <button type="button" onclick="this.closest('.variant-row').remove()"
                                        class="text-red-400 hover:text-red-600 text-lg leading-none transition-colors">×</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit"
                    class="bg-green-700 hover:bg-green-800 text-white font-bold px-8 py-3 rounded-xl transition-colors">
                @(Model.Id == 0 ? "Dodaj proizvod" : "Spremi promjene")
            </button>
            <a asp-action="Products"
               class="bg-white hover:bg-gray-50 text-gray-700 font-semibold px-6 py-3 rounded-xl border border-gray-200 transition-colors">
                Odustani
            </a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function previewImage(input) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const url = URL.createObjectURL(file);
        const preview = document.getElementById('img-preview');
        const wrap = document.getElementById('img-preview-wrap');
        preview.src = url;
        wrap.classList.remove('hidden');
        document.getElementById('upload-label').textContent = file.name;
    }

    let nextIndex = @Model.Variants.Count;

    function addVariant() {
        const container = document.getElementById('variants-container');
        const i = nextIndex++;
        const row = document.createElement('div');
        row.className = 'variant-row grid grid-cols-12 gap-3 items-center bg-gray-50 rounded-lg px-3 py-2.5';
        row.innerHTML = `
            <input type="hidden" name="Variants[${i}].Id" value="0" />
            <input type="hidden" name="Variants[${i}].Delete" value="false" class="delete-input" />
            <div class="col-span-3">
                <input name="Variants[${i}].Title" type="text" required placeholder="S, M, L / Vel. 5..."
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
            </div>
            <div class="col-span-3">
                <input name="Variants[${i}].Price" type="number" step="0.01" min="0.01" required placeholder="0.00"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
            </div>
            <div class="col-span-3">
                <input name="Variants[${i}].CompareAtPrice" type="number" step="0.01" min="0" placeholder="0.00"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
            </div>
            <div class="col-span-2">
                <input name="Variants[${i}].Stock" type="number" min="0" required placeholder="0"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-600" />
            </div>
            <div class="col-span-1 text-right">
                <button type="button" onclick="this.closest('.variant-row').remove()"
                        class="text-red-400 hover:text-red-600 text-lg leading-none transition-colors">×</button>
            </div>
        `;
        container.appendChild(row);
    }

    function markDelete(index, btn) {
        const row = document.getElementById('vrow-' + index);
        const deleteInput = row.querySelector('.delete-input');
        const isDeleting = deleteInput.value === 'false';
        deleteInput.value = isDeleting ? 'true' : 'false';
        row.classList.toggle('opacity-40', isDeleting);
        btn.title = isDeleting ? 'Poništi brisanje' : 'Označi za brisanje';
    }
</script>
}
