@model KickoffShop.Models.ProfileViewModel
@{
    ViewData["Title"] = "Moj profil";
}

<div class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-black mb-2">Moj profil</h1>
    <p class="text-gray-500 text-sm mb-8">Podaci koji se automatski popunjavaju na plaćanju.</p>

    @if (Model.Saved)
    {
        <div class="bg-green-50 border border-green-200 text-green-800 text-sm px-4 py-3 rounded-lg mb-6">
            Profil uspješno spremljen.
        </div>
    }

    <form asp-controller="Profile" asp-action="Index" method="post" class="mb-12">
        @Html.AntiForgeryToken()

        <div class="checkout-card mb-5">

            <div class="checkout-row">
                <h2>Osobni podaci</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Name" class="checkout-label">Ime i prezime</label>
                        <input asp-for="Name" type="text" placeholder="Pero Perić" class="checkout-input" />
                        <span asp-validation-for="Name" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="checkout-label">Email</label>
                        <input asp-for="Email" type="email" placeholder="pero@email.com" class="checkout-input" />
                        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="checkout-row">
                <h2>Adresa dostave</h2>
                <div class="space-y-4">
                    <div>
                        <label asp-for="Address" class="checkout-label">Adresa</label>
                        <input asp-for="Address" type="text" placeholder="Ulica i broj" class="checkout-input" />
                        <span asp-validation-for="Address" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="City" class="checkout-label">Grad</label>
                        <input asp-for="City" type="text" placeholder="Zagreb" class="checkout-input" />
                        <span asp-validation-for="City" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>
            </div>

        </div>

        <button type="submit" class="auth-btn">
            Spremi promjene
        </button>
    </form>

    <div>
        <div class="flex items-baseline gap-3 mb-5">
            <h2 class="text-xl font-black">Lista želja</h2>
            @if (Model.Wishlist.Any())
            {
                <span class="text-sm text-gray-400">@Model.Wishlist.Count @(Model.Wishlist.Count == 1 ? "proizvod" : "proizvoda")</span>
            }
        </div>

        @if (!Model.Wishlist.Any())
        {
            <div class="bg-white rounded-xl border border-gray-200 p-10 text-center text-gray-400">
                <div class="text-4xl mb-3">☆</div>
                <p class="text-sm">Nema spremljenih proizvoda.</p>
                <a asp-controller="Home" asp-action="Index" class="inline-block mt-4 text-sm text-green-700 hover:underline font-medium">
                    Pregledaj trgovinu →
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var item in Model.Wishlist)
                {
                    var p = item.Product;
                    var minPrice = p.Variants.Min(v => v.Price);

                    <div class="product-card">
                        <div class="product-card-inner flex flex-col">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Handle" class="block">
                                <div class="aspect-square bg-gray-100 overflow-hidden">
                                    <img src="@p.ImageUrl" alt="@p.Title"
                                         class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                                </div>
                            </a>
                            <div class="p-4 flex flex-col flex-1">
                                <span class="text-xs text-gray-400 uppercase tracking-wide">@p.ProductType</span>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.Handle"
                                   class="font-semibold mt-1 leading-snug hover:text-green-700 transition-colors">
                                    @p.Title
                                </a>
                                <div class="flex items-center justify-between mt-auto pt-3">
                                    <span class="text-lg font-bold">@minPrice.ToString("0.00") €</span>
                                    <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                                        <input type="hidden" name="productId" value="@p.Id" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Profile")" />
                                        <button type="submit" title="Ukloni iz liste želja"
                                                class="text-yellow-500 hover:text-gray-400 transition-colors text-xl leading-none">
                                            ★
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
