@model KickoffShop.Models.LoginViewModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="text-3xl font-black text-green-700 tracking-tight">Kickoff</a>
            <p class="text-gray-500 mt-2">Prijavite se u svoj račun</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg mb-4"></div>

            <div class="checkout-card mb-5">
                <div class="checkout-row">
                    <h2>Prijava</h2>
                    <div class="space-y-4">
                        <div>
                            <label class="checkout-label">Email</label>
                            <input asp-for="Email" type="email" placeholder="pero@email.com" autocomplete="email" class="checkout-input" />
                            <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label class="checkout-label">Lozinka</label>
                            <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" class="checkout-input" />
                            <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                    </div>
                </div>
                <div class="checkout-row">
                    <div class="flex items-center gap-2">
                        <input asp-for="RememberMe" type="checkbox" id="rememberMe"
                               class="w-4 h-4 rounded border-gray-300 text-green-600 focus:ring-green-500" />
                        <label for="rememberMe" class="text-sm text-gray-600">Zapamti me</label>
                    </div>
                </div>
            </div>

            <button type="submit" class="auth-btn">
                Prijava
            </button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
            Nemate račun?
            <a asp-controller="Account" asp-action="Register" class="text-green-700 font-semibold hover:underline">Registrirajte se</a>
        </p>

        <div class="mt-4 bg-blue-50 border border-blue-200 rounded-xl p-4 text-xs text-blue-700">
            <p class="font-semibold mb-1">Admin pristup (razvoj):</p>
            <p>Email: admin&#64;kickoff.hr</p>
            <p>Lozinka: Admin123!</p>
        </div>
    </div>
</div>
